# {{ ansible_managed }}
[Unit]
Description=NOC kiosk display (Xorg + Chrome, no window manager)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User={{ kiosk_user }}
Group={{ kiosk_user }}

# PAMName=login gives logind a real seat0 session, which is what lets a
# non-root Xorg take the DRM device on tty1.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user

Environment=HOME={{ kiosk_home }}
Environment=XDG_CACHE_HOME={{ kiosk_home }}/.cache

ExecStart=/usr/bin/xinit /usr/local/bin/kiosk-session -- /usr/bin/X :0 vt1 -nolisten tcp -noreset

# A NOC display must heal itself; nobody is standing there to restart it.
Restart=always
RestartSec=5s

# NB: ProtectHome must stay off and ProtectSystem must not be "strict" --
# both hide or freeze /run/user, which the session needs.
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths={{ kiosk_home }}
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
