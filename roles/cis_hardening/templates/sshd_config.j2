# {{ ansible_managed }}
# CIS Level 1 hardened SSH configuration
# Key-based non-root access is always permitted

Port {{ cis_hardening_ssh_port }}
AddressFamily any
ListenAddress 0.0.0.0
{% if not cis_hardening_disable_ipv6 %}
ListenAddress ::
{% endif %}

# Authentication
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
HostbasedAuthentication no
IgnoreRhosts yes
UsePAM yes
MaxAuthTries 4
LoginGraceTime 60
MaxSessions 4

# Access control
AllowUsers {{ cis_hardening_ssh_allow_users }}

# Security
X11Forwarding no
PermitUserEnvironment no
AllowAgentForwarding no
AllowTcpForwarding no
GatewayPorts no
PermitTunnel no
Compression no

# Cryptography
Ciphers aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org

# Session
ClientAliveInterval 300
ClientAliveCountMax 3
UseDNS no

# Logging
LogLevel INFO
SyslogFacility AUTH

# Banner
Banner /etc/issue.net

# SFTP
Subsystem sftp /usr/lib/openssh/sftp-server

# Deny kiosk user SSH access entirely
Match User {{ kiosk_user | default('kiosk') }}
    ForceCommand /bin/false
    PermitTTY no
    AllowTcpForwarding no
    X11Forwarding no
    AllowAgentForwarding no
